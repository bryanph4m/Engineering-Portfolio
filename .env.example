# Cal.com (free plan — Settings > Developer > API keys). CALCOM_EVENT_TYPE_ID
# is the event type bookings are created against (turn off its own
# confirmation email/workflow there, since Resend sends ours). Get the
# credential/external ID for a connected calendar via
# scripts/list-calcom-calendars.mjs.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_CALENDAR_CREDENTIAL_ID=
CALCOM_CALENDAR_EXTERNAL_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM=

# Static personal Zoom room link
ZOOM_LINK=

# Upstash QStash (schedules the day-of and T-minus-30 emails)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Upstash Redis (booking records + per-IP rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any random string — protects /api/bookings and admin-cancel
ADMIN_SECRET=

# Optional. Defaults to the production URL if unset. Set to a Vercel preview
# URL when testing bookings/cancellations/QStash callbacks against a preview
# deployment.
SITE_URL=

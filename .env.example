# Cal.com (free plan — Settings > Developer > API keys). CALCOM_EVENT_TYPE_ID
# is the event type bookings are created against — set its location to your
# Zoom link and add a Workflow there (confirmation is automatic; add a
# "before event" reminder) so Cal.com sends its own emails. Get the
# credential/external ID for a connected calendar via
# scripts/list-calcom-calendars.mjs.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_CALENDAR_CREDENTIAL_ID=
CALCOM_CALENDAR_EXTERNAL_ID=

# Upstash Redis (booking records + per-IP rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any random string — protects /api/bookings and admin-cancel
ADMIN_SECRET=

# Optional. Defaults to the production URL if unset. Set to a Vercel preview
# URL when testing bookings/cancellations against a preview deployment.
SITE_URL=
